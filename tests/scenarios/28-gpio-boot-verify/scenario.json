{
  "name": "gpio-boot-verify",
  "circuit": "test.sim1",
  "steps": [
    { "cmd": "run", "equals": "ok" },
    { "cmd": "wait_serial mega328-28 gpio-ready 5000", "equals": "found", "timeout": 10 },
    { "sleep_ms": 100 },
    { "cmd": "serial mega328-28", "contains": "pd4:high" },
    { "cmd": "pin_voltage mega328-28 PORTD4", "parse": "float", "min": 4.5 },
    { "cmd": "pin_voltage mega328-28 PORTD5", "parse": "float", "max": 0.5 },
    { "cmd": "pin_voltage mega328-28 PORTD2", "parse": "float", "min": 4.5 }
  ]
}
