<circuit version="1.1.0-SR2" rev="260418" stepSize="1000000" stepsPS="1000000" NLsteps="100000" reaStep="1000000" animate="0" >

<!-- Arduino Mega2560 board (SubCircuit) as I2C master -->
<item itemtype="Subcircuit" CircId="Mega-1" mainComp="false" Show_id="true" Show_Val="false" Pos="-388,-216" rotation="0" hflip="1" vflip="1" label="Mega-1" idLabPos="0,-20" labelrot="0" valLabPos="-16,20" valLabRot="0" Logic_Symbol="false">
<mainCompProps MainCompId="mega2560-63" Frequency="16 MHz" Program="firmware/mega_master.hex" Auto_Load="false" saveEepr="false" MainMcu="true" SerialMon="1" />
</item>

<!-- mega328 (Arduino Nano) as I2C slave at 0x08 -->
<!-- SDA=PC4, SCL=PC5 -->
<item itemtype="MCU" CircId="mega328-1" mainComp="false" Show_id="true" Show_Val="true" Pos="-60,-168" rotation="0" hflip="1" vflip="1" label="mega328-1" idLabPos="0,-20" labelrot="0" valLabPos="-16,20" valLabRot="0" Frequency="16 MHz" Program="firmware/nano_slave.hex" Auto_Load="false" saveEepr="false" Logic_Symbol="false" Rst_enabled="false" Ext_Osc="false" Wdt_enabled="false" Clk_Out="false" MainMcu="false" SerialMon="1" />

<!-- 5V Rail for pull-up resistors -->
<item itemtype="Rail" CircId="Rail-54" mainComp="false" ShowProp="Voltage" Show_id="false" Show_Val="true" Pos="-164,-72" rotation="90" hflip="1" vflip="1" label="Rail-54" idLabPos="-5,-10" labelrot="-90" valLabPos="-12,6" valLabRot="-90" Voltage="5 V" />

<!-- Pull-up resistors (1kΩ) on SDA and SCL (same as scenario 09) -->
<item itemtype="Resistor" CircId="Resistor-55" mainComp="false" ShowProp="Resistance" Show_id="false" Show_Val="true" Pos="-132,-32" rotation="0" hflip="1" vflip="1" label="Resistor-55" idLabPos="-16,-24" labelrot="0" valLabPos="-16,6" valLabRot="0" Resistance="1 kΩ" />
<item itemtype="Resistor" CircId="Resistor-57" mainComp="false" ShowProp="Resistance" Show_id="false" Show_Val="true" Pos="-132,-4" rotation="0" hflip="1" vflip="1" label="Resistor-57" idLabPos="-16,-24" labelrot="0" valLabPos="-16,6" valLabRot="0" Resistance="1 kΩ" />

<!-- Mega-side SCL tunnel (from Mega board pin 21) -->
<item itemtype="Tunnel" CircId="Tunnel-8" mainComp="false" Show_id="false" Show_Val="false" Pos="-400,-168" rotation="0" hflip="1" vflip="1" label="SCL" idLabPos="-16,-24" labelrot="0" valLabPos="-16,20" valLabRot="0" Name="SCL" IsBus="false" />
<!-- Mega-side SDA tunnel (from Mega board pin 20) -->
<item itemtype="Tunnel" CircId="Tunnel-9" mainComp="false" Show_id="false" Show_Val="false" Pos="-400,-160" rotation="0" hflip="1" vflip="1" label="SDA" idLabPos="-16,-24" labelrot="0" valLabPos="-16,20" valLabRot="0" Name="SDA" IsBus="false" />

<!-- Slave-side SDA tunnel (to mega328-1 PC4) -->
<item itemtype="Tunnel" CircId="Tunnel-12" mainComp="false" Show_id="false" Show_Val="false" Pos="36,-60" rotation="0" hflip="-1" vflip="1" label="Tunnel-12" idLabPos="-16,-24" labelrot="0" valLabPos="-16,20" valLabRot="0" Name="SDA" IsBus="false" />
<!-- Slave-side SCL tunnel (to mega328-1 PC5) -->
<item itemtype="Tunnel" CircId="Tunnel-13" mainComp="false" Show_id="false" Show_Val="false" Pos="36,-76" rotation="0" hflip="-1" vflip="1" label="Tunnel-13" idLabPos="-16,-24" labelrot="0" valLabPos="-16,20" valLabRot="0" Name="SCL" IsBus="false" />

<!-- Bus nodes: SDA and SCL junction points with resistors -->
<item itemtype="Node" CircId="Node-14" mainComp="false" Pos="-16,-60" />
<item itemtype="Node" CircId="Node-15" mainComp="false" Pos="0,-76" />
<item itemtype="Node" CircId="Node-58" mainComp="false" Pos="-164,-32" />
<item itemtype="Node" CircId="Node-59" mainComp="false" Pos="-92,-60" />
<item itemtype="Node" CircId="Node-60" mainComp="false" Pos="-68,-76" />

<!-- Mega board pin 21 (SCL) -> SCL tunnel -->
<item itemtype="Connector" uid="Connector-3" startpinid="Mega-1-21" endpinid="Tunnel-8-pin" pointList="-380,-168,-400,-168" />
<!-- Mega board pin 20 (SDA) -> SDA tunnel -->
<item itemtype="Connector" uid="Connector-4" startpinid="Mega-1-20" endpinid="Tunnel-9-pin" pointList="-380,-160,-400,-160" />

<!-- Rail -> Node-58 (power distribution node) -->
<item itemtype="Connector" uid="Connector-125" startpinid="Rail-54-outnod" endpinid="Node-58-0" pointList="-164,-56,-164,-32" />
<!-- Node-58 -> Resistor-55 (SCL pull-up top) -->
<item itemtype="Connector" uid="Connector-126" startpinid="Node-58-2" endpinid="Resistor-55-lPin" pointList="-164,-32,-148,-32" />
<!-- Node-58 -> Resistor-57 (SDA pull-up top) -->
<item itemtype="Connector" uid="Connector-124" startpinid="Node-58-1" endpinid="Resistor-57-lPin" pointList="-164,-32,-164,-4,-148,-4" />

<!-- Resistor-55 (SCL) bottom -> Node-59 -->
<item itemtype="Connector" uid="Connector-127" startpinid="Resistor-55-rPin" endpinid="Node-59-1" pointList="-116,-32,-92,-32,-92,-60" />
<!-- Resistor-57 (SDA) bottom -> Node-60 -->
<item itemtype="Connector" uid="Connector-130" startpinid="Resistor-57-rPin" endpinid="Node-60-1" pointList="-116,-4,-68,-4,-68,-76" />

<!-- mega328-1 PORTC4 (SDA) -> Node-14 -->
<item itemtype="Connector" uid="Connector-nano-sda" startpinid="mega328-1-PORTC4" endpinid="Node-14-0" pointList="-20,-152,-16,-152,-16,-60" />
<!-- mega328-1 PORTC5 (SCL) -> Node-15 -->
<item itemtype="Connector" uid="Connector-nano-scl" startpinid="mega328-1-PORTC5" endpinid="Node-15-0" pointList="-20,-144,0,-144,0,-76" />

<!-- Node-14 (SDA) -> Node-59 -->
<item itemtype="Connector" uid="Connector-129" startpinid="Node-59-2" endpinid="Node-14-1" pointList="-92,-60,-16,-60" />
<!-- Node-15 (SCL) -> Node-60 -->
<item itemtype="Connector" uid="Connector-132" startpinid="Node-60-2" endpinid="Node-15-1" pointList="-68,-76,0,-76" />

<!-- Node-14 -> SDA slave tunnel -->
<item itemtype="Connector" uid="Connector-10" startpinid="Node-14-2" endpinid="Tunnel-12-pin" pointList="-16,-60,36,-60" />
<!-- Node-15 -> SCL slave tunnel -->
